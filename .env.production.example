# Copy to a private file outside Git. Use a generated password without URL-special characters,
# or percent-encode it in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://rahcar:replace-with-a-long-random-password@db:5432/rahcar?sslmode=disable
PUBLIC_ORIGIN=https://cars.example.com
WEB_PORT=8080
# Absolute path to a private JSON file following feed-config.example.json.
FEED_CONFIG_PATH=/absolute/path/to/approved-feeds.json
# Optional bearer token for a feed configured with "token_env": "FEED_TOKEN".
FEED_TOKEN=
